ke-quantized Linear (inherits nn.Linear for seamless PTQ/INT4 export).\"\"\"\n46: \n47:     def __init__(\n48:         self,\n49:         in_features: int,\n50:         out_features: int,\n51:         bias: bool = False,\n52:         weight_bits: int = 8,\n53:         act_bits: Optional[int] = 8,\n54:     ) -> None:\n55:         super().__init__(in_features, out_features, bias=bias)\n56:         self.weight_bits = int(weight_bits)\n57:         self.act_bits = int(act_bits) if act_bits is not None else None\n58:         self.qat_enabled: bool = True\n59: \n60:     @staticmethod\n61:     def _fake_quant_sym(x: torch.Tensor, bits: int, dim: int = -1) -> torch.Tensor:\n62:         q_max = float((1 << (bits - 1)) - 1)\n63:         scale = x.detach().abs().amax(dim=dim, keepdim=True).clamp(min=1e-6) / q_max\n64:         x_q = torch.clamp(torch.round(x / scale), -q_max, q_max) * scale\n65:         return x + (x_q - x).detach()\n66: \n67:     def forward(self, x: torch.Tensor) -> torch.Tensor:\n68:         if not self.qat_enabled:\n69:             return F.linear(x, self.weight, self.bias)\n70:         w = self._fake_quant_sym(self.weight, self.weight_bits, dim=-1)\n71:         if self.act_bits is not None:\n72:             x = self._fake_quant_sym(x, self.act_bits, dim=-1)\n73:         return F.linear(x, w, self.bias)\n74: \n75: \n76: def make_linear(\n77:     in_features: int,\n78:     out_features: int,\n79:     bias: bool = False,\n80:     use_qat: bool = False,\n81:     weight_bits: int = 8,\n82:     act_bits: Optional[int] = 8,\n83: ) -> nn.Linear:\n84:     if use_qat:\n85:         return BitQuantLinear(\n86:             in_features,\n87:             out_features,\n88:             bias=bias,\n89:             weight_bits=weight_bits,\n90:             act_bits=act_bits,\n91:         )\n92:     return nn.Linear(in_features, out_features, bias=bias)\n93: \n94: \n95: # ----------------------------------------------------------------------\n96: # 2D-Safe Rotary Positional Embeddings\n97: # ----------------------------------------------------------------------\n98: class RotaryEmbedding(nn.Module):\n99:     \"\"\"Rotary position embedding supporting arbitrary 1D [S] or 2D [B, S] position_ids.\"\"\"\n100: \n101:     def __init__(\n102:         self,\n103:         head_dim: int,\n104:         max_position_embeddings: int = 4096,\n105:         theta: float = 100000.0,\n106:     ) -> None:\n107:         super().__init__()\n108:         if head_dim % 2 != 0:\n109:             raise ValueError(f\"head_dim must be even for RoPE, got {head_dim}\")\n110:         self.head_dim = int(head_dim)\n111:         self.max_position_embeddings = int(max_position_embeddings)\n112:         self.theta = float(theta)\n113: \n114:         inv_freq = 1.0 / (\n115:             self.theta\n116:             ** (torch.arange(0, self.head_dim, 2, dtype=torch.float32) / self.head_dim)\n117:         )\n118:         self.register_buffer(\"inv_freq\", inv_freq, persistent=False)\n119:         self._build_cache(self.max_position_embeddings)\n120: \n121:     def _build_cache(self, seq_len: int) -> None:\n122:         t = torch.arange(seq_len, device=self.inv_freq.device, dtype=torch.float32)\n123:         freqs = torch.outer(t, self.inv_freq)\n124:         emb = torch.cat([freqs, freqs], dim=-1)\n125:         self.register_buffer(\"cos_cached\", emb.cos(), persistent=False)\n126:         self.register_buffer(\"sin_cached\", emb.sin(), persistent=False)\n127: \n128:     def forward(\n129:         self,\n130:         position_ids: torch.Tensor,\n131:         dtype: Optional[torch.dtype] = None,\n132:     ) -> Tuple[torch.Tensor, torch.Tensor]:\n133:         \"\"\"Return (cos, sin) of shape [*position_ids.shape, head_dim].\n134: \n135:         Supports 1D [S] -> [S, D] and 2D [B, S] -> [B, S, D].\n136:         \"\"\"\n137:         pos = position_ids.to(device=self.inv_freq.device, dtype=torch.long)\n138:         # During ONNX export or out-of-range positions, compute directly from inv_freq\n139:         if torch.onnx.is_in_onnx_export():\n140:             freqs = pos.float().unsqueeze(-1) * self.inv_freq\n141:             emb = torch.cat([freqs, freqs], dim=-1)\n142:             cos, sin = emb.cos(), emb.sin()\n143:         else:\n144:             max_pos = int(pos.max().item()) if pos.numel() > 0 else 0\n145:             if max_pos >= self.cos_cached.shape[0]:\n146:                 new_len = max(max_pos + 1, self.cos_cached.shape[0] * 2)\n147:                 self._build_cache(new_len)\n148:             cos = self.cos_cached[pos]\n149:             sin = self.sin_cached[pos]\n150: \n151:         if dtype is not None:\n152:             cos = cos.to(dtype=dtype)\n153:             sin = sin.to(dtype=dtype)\n154:         return cos, sin\n155: \n156: \n157: def rotate_half(x: torch.Tensor) -> torch.Tensor:\n158:     x1 = x[..., : x.shape[-1] // 2]\n159:     x2 = x[..., x.shape[-1] // 2 :]\n160:     return torch.cat((-x2, x1), dim=-1)\n161: \n162: \n163: def apply_rotary_pos_emb(\n164:     q: torch.Tensor,\n165:     k: torch.Tensor,\n166:     cos: torch.Tensor,\n167:     sin: torch.Tensor,\n168: ) -> Tuple[torch.Tensor, torch.Tensor]:\n169:     \"\"\"Apply RoPE to q [B, S, H_q, D] and k [B, S, H_kv, D].\n170: \n171:     CRITICAL 2D RoPE FIX: Uses `cos.unsqueeze(-2)` / `sin.unsqueeze(-2)` so:\n172:       - 1D cos [S, D]    -> [S, 1, D]    broadcasts onto [B, S, H, D]\n173:       - 2D cos [B, S, D] -> [B, S, 1, D] broadcasts onto [B, S, H, D]\n174:     Never silently swaps S and H axes even when S == num_attention_heads!\n175:     \"\"\"\n176:     cos_b = cos.unsqueeze(-2)\n177:     sin_b = sin.unsqueeze(-2)\n178:     q_embed = (q * cos_b) + (rotate_half(q) * sin_b)\n179:     k_embed = (k * cos_b) + (rotate_half(k) * sin_b)\n180:     return q_embed, k_embed\n181: \n182: \n183: # ----------------------------------------------------------------------\n184: # KV Cache (FP and Optional Per-Token Per-Head INT8 Compression)\n185: # ----------------------------------------------------------------------\n186: @dataclass\n187: class QuantizedKV:\n188:     \"\"\"Symmetric per-token per-head INT8 KV cache (~3.7x smaller than FP32).\"\"\"\n189: \n190:     k_int8: torch.Tensor  # [B, H_kv, P, D], int8\n191:     k_scale: torch.Tensor  # [B, H_kv, P, 1], float16\n192:     v_int8: torch.Tensor  # [B, H_kv, P, D], int8\n193:     v_scale: torch.Tensor  # [B, H_kv, P, 1], float16\n194: \n195:     @property\n196:     def seq_len(self) -> int:\n197:         return int(self.k_int8.shape[2])\n198: \n199:     def dequantize(self, dtype: torch.dtype) -> Tuple[torch.Tensor, torch.Tensor]:\n200:         k = self.k_int8.to(dtype) * self.k_scale.to(dtype)\n201:         v = self.v_int8.to(dtype) * self.v_scale.to(dtype)\n202:         return k, v\n203: \n204:     def truncate(self, length: int) -> \"QuantizedKV\":\n205:         return QuantizedKV(\n206:             k_int8=self.k_int8[:, :, :length, :],\n207:             k_scale=self.k_scale[:, :, :length, :],\n208:             v_int8=self.v_int8[:, :, :length, :],\n209:             v_scale=self.v_scale[:, :, :length, :],\n210:         )\n211: \n212:     def nbytes(self) -> int:\n213:         return (\n214:             self.k_int8.numel() * self.k_int8.element_size()\n215:             + self.k_scale.numel() * self.k_scale.element_size()\n216:             + self.v_int8.numel() * self.v_int8.element_size()\n217:             + self.v_scale.numel() * self.v_scale.element_size()\n218:         )\n219: \n220: \n221: LayerKV = Union[Tuple[torch.Tensor, torch.Tensor], QuantizedKV]\n222: \n223: \n224: def quantize_kv_pair(k: torch.Tensor, v: torch.Tensor) -> QuantizedKV:\n225:     \"\"\"Quantize [B, H_kv, S, D] key/value tensors into symmetric INT8 + FP16 scales.\"\"\"\n226:     k_scale = (k.float().abs().amax(dim=-1, keepdim=True).clamp(min=1e-6) / 127.0).to(\n227:         torch.float16\n228:     )\n229:     v_scale = (v.float().abs().amax(dim=-1, keepdim=True).clamp(min=1e-6) / 127.0).to(\n230:         torch.float16\n231:     )\n232:     k_int8 = torch.clamp(torch.round(k.float() / k_scale.float()), -127, 127).to(\n233:         torch.int8\n234:     )\n235:     v_int8 = torch.clamp(torch.round(v.float() / v_scale.float()), -127, 127).to(\n236:         torch.int8\n237:     )\n238:     return QuantizedKV(k_int8=k_int8, k_scale=k_scale, v_int8=v_int8, v_scale=v_scale)\n239: \n240: \n241: def append_kv_cache(\n242:     past_kv: Optional[LayerKV],\n243:     k_new: torch.Tensor,\n244:     v_new: torch.Tensor,\n245:     quantize_kv: bool = False,\n246: ) -> Tuple[torch.Tensor, torch.Tensor, LayerKV]:\n247:     \"\"\"Concatenate past KV with new [B, H_kv, Q, D] tensors and build updated cache.\"\"\"\n248:     if past_kv is None:\n249:         k_full, v_full = k_new, v_new\n250:         if quantize_kv:\n251:             present: LayerKV = quantize_kv_pair(k_new, v_new)\n252:         else:\n253:             present = (k_full, v_full)\n254:         return k_full, v_full, present\n255: \n256:     if isinstance(past_kv, QuantizedKV):\n257:         k_past, v_past = past_kv.dequantize(k_new.dtype)\n258:         k_full = torch.cat([k_past, k_new], dim=2)\n259:         v_full = torch.cat([v_past, v_new], dim=2)\n260:         if quantize_kv:\n261:             new_q = quantize_kv_pair(k_new, v_new)\n262:             present = QuantizedKV(\n263:                 k_int8=torch.cat([past_kv.k_int8, new_q.k_int8], dim=2),\n264:                 k_scale=torch.cat([past_kv.k_scale, new_q.k_scale], dim=2),\n265:                 v_int8=torch.cat([past_kv.v_int8, new_q.v_int8], dim=2),\n266:                 v_scale=torch.cat([past_kv.v_scale, new_q.v_scale], dim=2),\n267:             )\n268:         else:\n269:             present = (k_full, v_full)\n270:         return k_full, v_full, present\n271: \n272:     k_past, v_past = past_kv\n273:     k_full = torch.cat([k_past, k_new], dim=2)\n274:     v_full = torch.cat([v_past, v_new], dim=2)\n275:     if quantize_kv:\n276:         present = quantize_kv_pair(k_full, v_full)\n277:     else:\n278:         present = (k_full, v_full)\n279:     return k_full, v_full, present\n280: \n281: \n282: def get_kv_seq_len(past_key_values: Optional[Sequence[LayerKV]]) -> int:\n283:     if not past_key_values:\n284:         return 0\n285:     first = past_key_values[0]\n286:     if isinstance(first, QuantizedKV):\n287:         return first.seq_len\n288:     return int(first[0].shape[2])\n289: \n290: \n291: def truncate_kv_cache(\n292:     past_key_values: Optional[Sequence[LayerKV]], length: int\n293: ) -> Optional[List[LayerKV]]:\n294:     if past_key_values is None:\n295:         return None\n296:     if length <= 0:\n297:         return None\n298:     out: List[LayerKV] = []\n299:     for entry in past_key_values:\n300:         if isinstance(entry, QuantizedKV):\n301:             out.append(entry.truncate(length))\n302:         else:\n303:             k, v = entry\n304:             out.append((k[:, :, :length, :], v[:, :, :length, :]))\n305:     return out\n306: \n307: \n308: def kv_cache_nbytes(past_key_values: Optional[Sequence[LayerKV]]) -> int:\n309:     if not past_key_values:\n310:         return 0\n311:     total = 0\n312:     for entry in past_key_values:\n313:         if isinstance(entry, QuantizedKV):\n314:             total += entry.nbytes()\n315:         else:\n316:             k, v = entry\n317:             total += k.numel() * k.element_size() + v.numel() * v.element_size()\n318:     return total\n319: \n320: \n321: # ----------------------------------------------------------------------\n322: # Explicit 4D Additive Attention Masks (Zero `torch.all(mask==1)`)\n323: # ----------------------------------------------------------------------\n324: def _bool_to_additive_mask(\n325:     allowed: torch.Tensor,\n326:     dtype: torch.dtype,\n327:     self_col_indices: Optional[torch.Tensor] = None,\n328: ) -> torch.Tensor:\n329:     \"\"\"Convert [B, 1, Q, K] bool mask (True=attend) into NaN-safe additive float mask.\"\"\"\n330:     # Ensure no query row is all-False (prevents NaN softmax on fully padded rows)\n331:     if self_col_indices is not None:\n332:         row_empty = ~allowed.any(dim=-1, keepdim=True)\n333:         k_idx = torch.arange(allowed.shape[-1], device=allowed.device)\n334:         diag = k_idx.view(1, 1, 1, -1) == self_col_indices.view(1, 1, -1, 1)\n335:         allowed = allowed | (row_empty & diag)\n336: \n337:     neg_val = torch.finfo(dtype).min if dtype.is_floating_point else -1e9\n338:     zero = torch.zeros((), device=allowed.device, dtype=dtype)\n339:     neg = torch.full((), neg_val, device=allowed.device, dtype=dtype)\n340:     return torch.where(allowed, zero, neg)\n341: \n342: \n343: def build_causal_mask(\n344:     q_len: int,\n345:     kv_len: int,\n346:     past_len: int,\n347:     batch_size: int,\n348:     key_padding_mask: Optional[torch.Tensor] = None,\n349:     device: Optional[torch.device] = None,\n350:     dtype: torch.dtype = torch.float32,\n351: ) -> torch.Tensor:\n352:     \"\"\"Build explicit 4D bottom-right causal mask [B, 1, Q, K] (`k_idx <= past_len + q_idx`).\n353: \n354:     Handles arbitrary chunk commits onto cached prefixes (`kv_len == past_len + q_len`).\n355:     \"\"\"\n356:     q_idx = torch.arange(q_len, device=device, dtype=torch.long)\n357:     k_idx = torch.arange(kv_len, device=device, dtype=torch.long)\n358:     causal = k_idx.unsqueeze(0) <= (past_len + q_idx.unsqueeze(1))  # [Q, K]\n359:     allowed = causal.unsqueeze(0).unsqueeze(0).expand(batch_size, 1, q_len, kv_len)\n360: \n361:     if key_padding_mask is not None:\n362:         kpm = key_padding_mask.to(device=device, dtype=torch.bool)\n363:         if kpm.shape[1] == q_len and past_len > 0:\n364:             past_valid = torch.ones(\n365:                 (batch_size, past_len), device=device, dtype=torch.bool\n366:             )\n367:             kpm = torch.cat([past_valid, kpm], dim=1)\n368:         allowed = allowed & kpm[:, None, None, :]\n369: \n370:     self_cols = (past_len + q_idx).clamp(max=kv_len - 1)\n371:     return _bool_to_additive_mask(allowed, dtype=dtype, self_col_indices=self_cols)\n372: \n373: \n374: def build_concept_mask(\n375:     prefix_len: int,\n376:     level_lengths: Sequence[int],\n377:     batch_size: int,\n378:     prefix_mask: Optional[torch.Tensor] = None,\n379:     device: Optional[torch.device] = None,\n380:     dtype: torch.dtype = torch.float32,\n381: ) -> torch.Tensor:\n382:     \"\"\"Build 4D Causal-Prefix + Block-Diagonal Target mask [B, 1, P+T, P+T].\n383: \n384:     - Prefix [0:P] attends CAUSALLY to prefix [0:P] only (enables incremental KV reuse).\n385:     - Target level k attends to all valid prefix tokens [0:P] + bidirectionally within level k.\n386:     - Cross-level target attention is strictly blocked (zero target KV cache growth).\n387:     \"\"\"\n388:     total_target = sum(level_lengths)\n389:     total_len = prefix_len + total_target\n390:     allowed = torch.zeros((total_len, total_len), device=device, dtype=torch.bool)\n391: \n392:     if prefix_len > 0:\n393:         p_idx = torch.arange(prefix_len, device=device)\n394:         allowed[:prefix_len, :prefix_len] = p_idx.unsqueeze(0) <= p_idx.unsqueeze(1)\n395:         allowed[prefix_len:, :prefix_len] = True\n396: \n397:     offset = prefix_len\n398:     for l_k in level_lengths:\n399:         allowed[offset : offset + l_k, offset : offset + l_k] = True\n400:         offset += l_k\n401: \n402:     allowed_4d = allowed.unsqueeze(0).unsqueeze(0).expand(batch_size, 1, total_len, total_len)\n403: \n404:     if prefix_mask is not None and prefix_len > 0:\n405:         pm = prefix_mask.to(device=device, dtype=torch.bool)\n406:         target_valid = torch.ones(\n407:             (batch_size, total_target), device=device, dtype=torch.bool\n408:         )\n409:         key_valid = torch.cat([pm, target_valid], dim=1)\n410:         allowed_4d = allowed_4d & key_valid[:, None, None, :]\n411: \n412:     self_cols = torch.arange(total_len, device=device, dtype=torch.long)\n413:     return _bool_to_additive_mask(allowed_4d, dtype=dtype, self_col_indices=self_cols)\n414: \n415: \n416: def build_cached_concept_step_mask(\n417:     prefix_len: int,\n418:     level_len: int,\n419:     batch_size: int,\n420:     prefix_mask: Optional[torch.Tensor] = None,\n421:     device: Optional[torch.device] = None,\n422:     dtype: torch.dtype = torch.float32,\n423: ) -> torch.Tensor:\n424:     \"\"\"Build 4D mask [B, 1, l_k, P + l_k] for a cached concept level step.\"\"\"\n425:     kv_len = prefix_len + level_len\n426:     allowed = torch.ones((batch_size, 1, level_len, kv_len), device=device, dtype=torch.bool)\n427:     if prefix_mask is not None and prefix_len > 0:\n428:         pm = prefix_mask.to(device=device, dtype=torch.bool)\n429:         target_valid = torch.ones(\n430:             (batch_size, level_len), device=device, dtype=torch.bool\n431:         )\n432:         key_valid = torch.cat([pm, target_valid], dim=1)\n433:         allowed = allowed & key_valid[:, None, None, :]\n434:     self_cols = torch.arange(prefix_len, kv_len, device=device, dtype=torch.long)\n435:     return _bool_to_additive_mask(allowed, dtype=dtype, self_col_indices=self_cols)\n436: \n437: \n438: def build_bidirectional_mask(\n439:     seq_len: int,\n440:     batch_size: int,\n441:     attention_mask: Optional[torch.Tensor] = None,\n442:     device: Optional[torch.device] = None,\n443:     dtype: torch.dtype = torch.float32,\n444: ) -> torch.Tensor:\n445:     \"\"\"Build 4D bidirectional mask [B, 1, L, L] for the Stage 1 Concept Decoder.\"\"\"\n446:     allowed = torch.ones((batch_size, 1, seq_len, seq_len), device=device, dtype=torch.bool)\n447:     if attention_mask is not None:\n448:         kpm = attention_mask.to(device=device, dtype=torch.bool)\n449:         allowed = allowed & kpm[:, None, None, :]\n450:     self_cols = torch.arange(seq_len, device=device, dtype=torch.long)\n451:     return _bool_to_additive_mask(allowed, dtype=dtype, self_col_indices=self_cols)\n452: \n453: \n454: # ----------------------------------------------------------------------\n455: # Attention, SwiGLU, Loop Adapter & Transformer Blocks\n456: # ----------------------------------------------------------------------\n457: def repeat_kv(x: torch.Tensor, n_rep: int) -> torch.Tensor:\n458:     \"\"\"Repeat KV heads [B, H_kv, S, D] -> [B, H_kv * n_rep, S, D].\"\"\"\n459:     if n_rep == 1:\n460:         return x\n461:     b, h_kv, s, d = x.shape\n462:     return x[:, :, None, :, :].expand(b, h_kv, n_rep, s, d).reshape(b, h_kv * n_rep, s, d)\n463: \n464: \n465: def scaled_dot_product_attn_4d(\n466:     q: torch.Tensor,\n467:     k: torch.Tensor,\n468:     v: torch.Tensor,\n469:     attn_mask: torch.Tensor,\n470:     dropout_p: float = 0.0,\n471: ) -> torch.Tensor:\n472:     \"\"\"Explicit-4D SDPA (`is_causal=False`) with ONNX opset 17 matmul fallback.\"\"\"\n473:     if torch.onnx.is_in_onnx_export():\n474:         scale = 1.0 / math.sqrt(float(q.shape[-1]))\n475:         scores = torch.matmul(q, k.transpose(-2, -1)) * scale + attn_mask\n476:         probs = F.softmax(scores.float(), dim=-1).to(q.dtype)\n477:         return torch.matmul(probs, v)\n478: \n479:     return F.scaled_dot_product_attention(\n480:         q,\n481:         k,\n482:         v,\n483:         attn_mask=attn_mask,\n484:         dropout_p=dropout_p,\n485:         is_causal=False,\n486:     )\n487: \n488: \n489: class SwiGLU(nn.Module):\n490:     \"\"\"SwiGLU feed-forward network (bias-free).\"\"\"\n491: \n492:     def __init__(\n493:         self,\n494:         hidden_size: int,\n495:         intermediate_size: int,\n496:         use_qat: bool = False,\n497:         weight_bits: int = 8,\n498:         act_bits: Optional[int] = 8,\n499:     ) -> None:\n500:         super().__init__()\n501:         self.gate_proj = make_linear(\n502:             hidden_size, intermediate_size, bias=False, use_qat=use_qat, weight_bits=weight